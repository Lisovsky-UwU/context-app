DATABASE_URL=postgresql+psycopg://context:context@localhost:5433/context
SECRET_KEY=смените-на-случайные-64-символа
COOKIE_SECURE=true
JWT_EXPIRES_DAYS=30

# Подсказки адресов: бесплатный ключ на dadata.ru (Личный кабинет → API-ключ)
DADATA_API_KEY=

# Город по умолчанию для подсказок и центра карты
DEFAULT_CITY=Москва
DEFAULT_CENTER_LAT=55.751244
DEFAULT_CENTER_LON=37.618423

UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173
