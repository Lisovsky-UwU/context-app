# Порт, который слушает приложение на сервере. Внешний nginx проксирует сюда.
APP_PORT=8080

# Секрет для подписи сессий: openssl rand -hex 32
SECRET_KEY=

# true — кука только по https (так и должно быть в проде)
COOKIE_SECURE=true

POSTGRES_USER=context
POSTGRES_PASSWORD=
POSTGRES_DB=context

# Подсказки адресов: бесплатный ключ в личном кабинете dadata.ru
DADATA_API_KEY=

DEFAULT_CITY=Москва
DEFAULT_CENTER_LAT=55.751244
DEFAULT_CENTER_LON=37.618423

MAX_UPLOAD_MB=15
